# ==============================================================================
# SokoLink Frontend - Production Environment Variables (Vercel)
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend API Integration (Render Backend)
# ------------------------------------------------------------------------------
# Set to your deployed Render backend URL.
# Next.js will automatically proxy all /api/* routes directly to Render!
BACKEND_API_URL="https://sokolink-backend.onrender.com"
NEXT_PUBLIC_API_URL="https://sokolink-backend.onrender.com/api"

# ------------------------------------------------------------------------------
# Neon Serverless PostgreSQL Database (for Next.js SSR Server Components)
# ------------------------------------------------------------------------------
# Pooled connection string with ?sslmode=require
DATABASE_URL="postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/sokolink?sslmode=require"
DIRECT_URL="postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/sokolink?sslmode=require"

# ------------------------------------------------------------------------------
# Auth & Security (Must match backend JWT_SECRET)
# ------------------------------------------------------------------------------
JWT_SECRET="generate-a-strong-secret-key-min-32-chars"
NEXTAUTH_SECRET="generate-a-strong-secret-key-min-32-chars"
NEXTAUTH_URL="https://your-sokolink-frontend.vercel.app"

# ------------------------------------------------------------------------------
# App Branding & Public URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://your-sokolink-frontend.vercel.app"
NEXT_PUBLIC_APP_NAME="SokoLink"

# ------------------------------------------------------------------------------
# Safaricom M-Pesa Configuration (Optional on Frontend when proxied to Render)
# ------------------------------------------------------------------------------
MPESA_ENVIRONMENT="sandbox"
MPESA_SHORTCODE="174379"
