# ==============================================================================
# SokoLink Backend - Production Environment Variables (Render & Neon)
# ==============================================================================

# Node Environment & Port
NODE_ENV="production"
PORT=10000

# ------------------------------------------------------------------------------
# Neon Serverless PostgreSQL Database
# ------------------------------------------------------------------------------
# 1. Pooled Connection (used by application for fast queries & connection pooling)
DATABASE_URL="postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/sokolink?sslmode=require"

# 2. Direct Connection (used for prisma db push & schema migrations)
DIRECT_URL="postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/sokolink?sslmode=require"

# ------------------------------------------------------------------------------
# Security & JWT Auth
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET="generate-a-strong-secret-key-min-32-chars"

# ------------------------------------------------------------------------------
# Frontend & CORS Configuration (Vercel)
# ------------------------------------------------------------------------------
FRONTEND_URL="https://your-sokolink-frontend.vercel.app"
CORS_ORIGIN="https://your-sokolink-frontend.vercel.app"
NEXT_PUBLIC_APP_URL="https://your-sokolink-frontend.vercel.app"

# ------------------------------------------------------------------------------
# Safaricom M-Pesa Daraja Gateway
# ------------------------------------------------------------------------------
MPESA_ENVIRONMENT="sandbox" # Change to "production" for live payments
MPESA_CONSUMER_KEY="your_consumer_key"
MPESA_CONSUMER_SECRET="your_consumer_secret"
MPESA_PASSKEY="bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919"
MPESA_SHORTCODE="174379"
MPESA_CALLBACK_URL="https://sokolink-backend.onrender.com/api/payments/mpesa/callback"

# ------------------------------------------------------------------------------
# SMS Notifications (Africa's Talking / Sandbox)
# ------------------------------------------------------------------------------
SMS_PROVIDER="sandbox"
SMS_API_KEY=""
SMS_USERNAME=""
SMS_SENDER_ID="SOKOLINK"
