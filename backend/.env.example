# Database
DATABASE_URL="postgresql://username:password@localhost:5432/sokolink?schema=public"

# Auth & Security
JWT_SECRET="replace-with-a-secure-random-32-byte-hex-or-base64-string"
NEXTAUTH_SECRET="replace-with-a-secure-random-string"
NEXTAUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="SokoLink"

# M-Pesa Daraja Sandbox
MPESA_ENVIRONMENT="sandbox"
MPESA_CONSUMER_KEY="your_sandbox_consumer_key"
MPESA_CONSUMER_SECRET="your_sandbox_consumer_secret"
