# ==============================================================================
# SokoLink Platform - Environment Variables Template
# ==============================================================================

# Database (Neon Serverless PostgreSQL or Local)
# In Neon: use the pooled URL for DATABASE_URL and the direct URL for DIRECT_URL
DATABASE_URL="postgresql://user:password@ep-xyz-pooler.region.aws.neon.tech/sokolink?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xyz.region.aws.neon.tech/sokolink?sslmode=require"

# Auth & Security
JWT_SECRET="replace-with-a-secure-random-32-byte-hex-or-base64-string"
NEXTAUTH_SECRET="replace-with-a-secure-random-string"
NEXTAUTH_URL="https://your-frontend.vercel.app"

# Service URLs
PORT=5000
BACKEND_API_URL="https://sokolink-backend.onrender.com"
NEXT_PUBLIC_API_URL="https://sokolink-backend.onrender.com/api"
NEXT_PUBLIC_APP_URL="https://your-frontend.vercel.app"
CORS_ORIGIN="https://your-frontend.vercel.app"
FRONTEND_URL="https://your-frontend.vercel.app"
NEXT_PUBLIC_APP_NAME="SokoLink"

# Safaricom M-Pesa Daraja Gateway
MPESA_ENVIRONMENT="sandbox" # or "production"
MPESA_CONSUMER_KEY="your_mpesa_consumer_key"
MPESA_CONSUMER_SECRET="your_mpesa_consumer_secret"
MPESA_PASSKEY="bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919"
MPESA_SHORTCODE="174379"
MPESA_CALLBACK_URL="https://sokolink-backend.onrender.com/api/payments/mpesa/callback"

# Object Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME="demo"
CLOUDINARY_API_KEY="123456789"
CLOUDINARY_API_SECRET="placeholder"

# Notification Provider
SMS_PROVIDER="sandbox"
SMS_API_KEY=""
SMS_USERNAME=""
SMS_SENDER_ID="SOKOLINK"
EMAIL_PROVIDER="smtp"
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="2525"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@sokolink.co.ke"
